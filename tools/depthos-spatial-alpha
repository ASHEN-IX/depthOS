def depthos_executable():
    """Locate the depthos binary without touching a database.
    Order:
      1. Explicit global DEPTHOS / CLI override
      2. DEPTHOS_BIN env var
      3. Sibling binary in the same directory: <prefix>/bin/depthos
      4. System PATH: shutil.which("depthos")
      5. Development fallback: ROOT/target/release/depthos, ROOT/target/debug/depthos, CARGO_TARGET_DIR
    """
    candidates = []
    if DEPTHOS:
        candidates.append(Path(DEPTHOS))
    env_bin = os.environ.get("DEPTHOS_BIN")
    if env_bin:
        candidates.append(Path(env_bin))

    # Sibling binary: e.g. <prefix>/bin/depthos when launcher is <prefix>/bin/depthos-spatial-alpha
    sibling = Path(__file__).resolve().parent / "depthos"
    candidates.append(sibling)

    # PATH lookup
    path_bin = shutil.which("depthos")
    if path_bin:
        candidates.append(Path(path_bin))

    # Development repository fallback
    cargo = os.environ.get("CARGO_TARGET_DIR")
    if cargo:
        candidates.append(Path(cargo) / "release" / "depthos")
        candidates.append(Path(cargo) / "debug" / "depthos")
    candidates.append(ROOT / "target" / "release" / "depthos")
    candidates.append(ROOT / "target" / "debug" / "depthos")

    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate.resolve()
    return None


def run_depthos(args, timeout=10.0):
    exe = depthos_executable()
    if exe is None:
        return None
    try:
        return subprocess.run([str(exe), *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(
            args, returncode=124, stdout="",
            stderr=f"depthos command timed out after {timeout} seconds",
        )
    except Exception as exc:
        return subprocess.CompletedProcess(
            args, returncode=1, stdout="",
            stderr=str(exc),
        )


def status_json(db_path):
    """Read-only probe. Never creates or migrates the database."""
    cmd = ["status", "--json"]
    if db_path is not None:
        cmd = ["--db", str(db_path), *cmd]
    proc = run_depthos(cmd)
    if proc is None:
        return None, "depthos binary was not found. Nothing was created or modified."
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "status failed").strip()
        return None, detail
    try:
        return json.loads(proc.stdout), None
    except json.JSONDecodeError as exc:
        return None, f"depthos status returned invalid JSON: {exc}"


def clear_hierarchy(backend):
    for prop in ("worlds", "workspaces", "desktops", "windows"):
        backend.setProperty(prop, [])
    for prop in ("selectedWorldId", "selectedWorkspaceId", "selectedDesktopId", "selectedWindowId"):
        backend.setProperty(prop, "")
    backend.setProperty("mockMode", False)
    backend.setProperty("observerLive", False)
    backend.setProperty("observationHealth", "Unavailable")
    backend.setProperty("sourceKind", "none")
    backend.setProperty("sourceLoadedAt", "")
    backend.setProperty("state", "Unavailable")


def apply_sqlite_provenance(backend, db_path):
    backend.setProperty("mockMode", False)
    backend.setProperty("sourceKind", "sqlite")
    backend.setProperty("sourceLoadedAt", date_label())
    backend.setProperty("sourceDetail", str(db_path))
    backend.setProperty("state", "Database Mode")
    backend.setProperty("health", "Local")
    # A local file is not a native observer, even when the read succeeded.
    backend.setProperty("observerLive", False)
    backend.setProperty("observerDetail", "Local SQLite has no native observation channel")
    backend.setProperty("observationHealth", "Unavailable")
    backend.setProperty("databasePath", str(db_path))
    backend.setProperty("databaseState", "valid")


def load_from_db_path(db_path, backend):
    exe = depthos_executable()
    if exe is None:
        return False
    try:
        proc = subprocess.run(
            [str(exe), "--db", str(db_path), "tree"],
            capture_output=True, text=True, check=True,
        )
        data = json.loads(proc.stdout)
        worlds = []
        workspaces = []
        desktops = []
        for w in data.get("worlds", []):
            world_info = w.get("world", {})
            w_id = world_info.get("id")
            worlds.append({
                "id": w_id,
                "name": world_info.get("name", "World"),
                "description": world_info.get("description") or "",
                "visualIdentity": world_info.get("visual_identity") or "",
                "artworkIdentifier": world_info.get("artwork_identifier") or "",
                "version": world_info.get("version", 1),
            })
            for ws in w.get("workspaces", []):
                ws_info = ws.get("workspace", {})
                ws_id = ws_info.get("id")
                workspaces.append({
                    "id": ws_id,
                    "worldId": w_id,
                    "name": ws_info.get("name", "Workspace"),
                    "description": ws_info.get("description") or "",
                    "rootDirectory": ws_info.get("root_directory") or "",
                    "visualIdentity": ws_info.get("visual_identity") or "",
                    "version": ws_info.get("version", 1),
                    "updatedAt": date_label(ws_info["updated_at_ms"]) if ws_info.get("updated_at_ms") else "",
                })
                for d in ws.get("desktops", []):
                    desktops.append({
                        "id": d.get("id"),
                        "workspaceId": ws_id,
                        "name": d.get("name", "Desktop"),
                        "role": d.get("role") or "",
                        "visualIdentity": d.get("visual_identity") or "",
                        "version": d.get("version", 1),
                    })
        backend.setProperty("worlds", worlds)
        backend.setProperty("workspaces", workspaces)
        backend.setProperty("desktops", desktops)
        backend.setProperty("windows", [])
        apply_sqlite_provenance(backend, db_path)

        prev_world = backend.property("selectedWorldId")
        prev_ws = backend.property("selectedWorkspaceId")
        prev_dt = backend.property("selectedDesktopId")

        world = next((w for w in worlds if w["id"] == prev_world), worlds[0] if worlds else None)
        descendants = [w for w in workspaces if world and w["worldId"] == world["id"]]
        workspace = next((w for w in descendants if w["id"] == prev_ws),
                         descendants[0] if descendants else None)
        descendants_dt = [d for d in desktops if workspace and d["workspaceId"] == workspace["id"]]
        desktop = next((d for d in descendants_dt if d["id"] == prev_dt),
                       descendants_dt[0] if descendants_dt else None)

        backend.setProperty("selectedWorldId", world["id"] if world else "")
        backend.setProperty("selectedWorkspaceId", workspace["id"] if workspace else "")
        backend.setProperty("selectedDesktopId", desktop["id"] if desktop else "")
        return True
    except Exception:
        sys.stderr.write("depthos-spatial-alpha: Could not read the logical hierarchy from SQLite.\n")
        return False


def read_shelves(query, endpoint, hierarchy, revision, instance):
    import dbus

    parents = {d["id"]: d["workspaceId"] for d in hierarchy[2]}
    workspaces = {w["id"] for w in hierarchy[1]}
    cursor, expected = 0, ""
    windows, seen = [], set()
    for _ in range(64):
        reply = query(endpoint.GetDesktopShelves, dbus.UInt32(cursor), expected)
        data = reply["data"]
        freshness = data["freshness"]
        if ((expected and reply["revision"] != expected) or reply["instanceId"] != instance
                or data["hierarchyRevision"] != revision
                or data["titlePolicy"] != "withheld"):
            raise ValueError("Incompatible shelf projection")
        if type(reply["available"]) is not bool:
            raise ValueError("Invalid shelf availability")
        items, next_cursor = data["items"], data["nextCursor"]
        if not reply["available"]:
            if cursor or items or next_cursor is not None or freshness not in ("stale", "unavailable"):
                raise ValueError("Invalid unavailable projection")
            return freshness, []
        if freshness != "live" or not re.fullmatch(r"[1-9][0-9]{0,19}", data["lastValidatedSequence"]):
            raise ValueError("Invalid shelf evidence")
        if not isinstance(items, list) or len(items) > 64:
            raise ValueError("Invalid shelf page")
        expected = reply["revision"]
        for row in items:
            if set(row) != {"id", "workspaceId", "desktopId", "applicationId", "assignment", "focused"}:
                raise ValueError("Unknown window field")
            identifier, workspace, desktop = row["id"], row["workspaceId"], row["desktopId"]
            app_id, assignment = row["applicationId"], row["assignment"]
            if (not re.fullmatch(r"[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}", identifier)
                    or identifier in seen or workspace not in workspaces
                    or (desktop is not None and parents.get(desktop) != workspace)
                    or assignment not in ("observed", "explicit", "unassigned", "unknown")
                    or ((desktop is not None) != (assignment in ("observed", "explicit")))
                    or (app_id is not None and not re.fullmatch(r"[A-Za-z0-9._-]{1,160}", app_id))
                    or type(row["focused"]) is not bool):
                raise ValueError("Invalid window record")
            seen.add(identifier)
            windows.append({"id": identifier, "workspaceId": workspace, "desktopId": desktop,
                            "appId": app_id, "titleRedacted": True, "assignment": assignment,
                            "focused": row["focused"], "statusBadge": "Live"})
        if next_cursor is None:
            return freshness, windows
        if next_cursor != cursor + 64 or len(items) != 64 or next_cursor >= 4096:
            raise ValueError("Invalid shelf cursor")
        cursor = next_cursor
    raise ValueError("Shelf page limit exceeded")


def read_controller(owner, previous=None, scopes=7):
    """Fetch the bounded read-only projection on a worker thread."""
    import dbus

    bus = dbus.SessionBus(private=True)
    try:
        endpoint = dbus.Interface(
            bus.get_object(owner, CONTROLLER_PATH, introspect=False), CONTROLLER_INTERFACE
        )
        deadline = time.monotonic() + 2

        def query(method, *args):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Controller read timed out")
            reply = json.loads(str(method(*args, timeout=remaining)))
            if type(reply.get("schemaVersion")) is not int or reply["schemaVersion"] != 1:
                raise ValueError("Unsupported controller reply")
            return reply

        if previous is None or scopes & 1:
            capabilities = query(endpoint.GetCapabilities)
            capability_data = capabilities["data"]
            instance = capabilities["instanceId"]
            if capability_data.get("readOnly") is not True or capability_data.get("assignmentMutations") is not False:
                raise ValueError("Incompatible controller capabilities")
            shelf_version = capability_data.get("desktopShelvesVersion")
            cursor, revision = 0, ""
            worlds, workspaces, desktops = [], [], []
            for _ in range(64):
                reply = query(endpoint.GetHierarchy, dbus.UInt32(cursor), revision)
                if reply["instanceId"] != instance:
                    raise ValueError("Hierarchy owner changed")
                revision = reply["revision"]
                for item in reply["data"]["items"]:
                    kind = item["kind"]
                    row = {"id": item["id"], "name": item["name"]}
                    if kind == "world":
                        worlds.append(row)
                    elif kind == "workspace":
                        row["worldId"] = item["parentId"]
                        workspaces.append(row)
                    elif kind == "desktop":
                        row["workspaceId"] = item["parentId"]
                        desktops.append(row)
                next_cursor = reply["data"]["nextCursor"]
                if next_cursor is None:
                    break
                if next_cursor != cursor + 64 or next_cursor >= 4096:
                    raise ValueError("Invalid hierarchy cursor")
                cursor = next_cursor
            else:
                raise ValueError("Hierarchy page limit exceeded")
            hierarchy = (worlds, workspaces, desktops)
            available = reply["available"]
            previous = (hierarchy, revision, available, instance, shelf_version)
        hierarchy, revision, available, instance, shelf_version = previous
        health_reply = query(endpoint.GetControllerHealth)
        if health_reply["instanceId"] != instance:
            raise ValueError("Controller owner changed")
        health = health_reply["data"].get("health") or {}
        shelves = None
        retry = False
        if scopes & 5:
            if not available or type(shelf_version) is not int or shelf_version != 1:
                shelves = ("unavailable", [])
            else:
                try:
                    shelves = read_shelves(query, endpoint, hierarchy, revision, instance)
                except dbus.exceptions.DBusException as exc:
                    retry = exc.get_dbus_name() == "org.freedesktop.DBus.Error.InvalidArgs"
                    shelves = ("unavailable", [])
                except (ValueError, KeyError, TypeError):
                    shelves = ("unavailable", [])
        return previous, health, shelves, retry
    finally:
        bus.close()


def apply_controller_hierarchy(backend, hierarchy):
    worlds, workspaces, desktops = hierarchy
    previous_desktop = backend.property("selectedDesktopId")
    previous_workspace = backend.property("selectedWorkspaceId")
    previous_world = backend.property("selectedWorldId")
    backend.setProperty("worlds", worlds)
    backend.setProperty("workspaces", workspaces)
    backend.setProperty("desktops", desktops)
    world = next((w for w in worlds if w["id"] == previous_world), worlds[0] if worlds else None)
    descendants = [w for w in workspaces if world and w["worldId"] == world["id"]]
    workspace = next((w for w in descendants if w["id"] == previous_workspace),
                     descendants[0] if descendants else None)
    descendants = [d for d in desktops if workspace and d["workspaceId"] == workspace["id"]]
    desktop = next((d for d in descendants if d["id"] == previous_desktop),
                   descendants[0] if descendants else None)
    backend.setProperty("selectedWorldId", world["id"] if world else "")
    backend.setProperty("selectedWorkspaceId", workspace["id"] if workspace else "")
    backend.setProperty("selectedDesktopId", desktop["id"] if desktop else "")


def apply_controller_health(backend, health, hierarchy_available):
    lifecycle = health.get("lifecycle", "Unknown")
    observation = health.get("observation", "Unknown")
    observer_live = observation == "Synchronized"
    if observer_live:
        observation_health = "Live"
    elif observation == "Desynchronized":
        observation_health = "Stale"
    elif lifecycle in ("WaitingForObserver", "Recovering"):
        observation_health = "Reconnecting"
    else:
        observation_health = "Unavailable"

    backend.setProperty("onboardingState", "hidden")
    backend.setProperty("mockMode", False)
    backend.setProperty("sourceKind", "controller")
    detail = CONTROLLER_SERVICE if hierarchy_available else "Hierarchy unavailable"
    backend.setProperty("sourceDetail", detail)
    backend.setProperty("state", "Connected")
    backend.setProperty("health", lifecycle)
    backend.setProperty("observerLive", observer_live)
    backend.setProperty("observerDetail", observation)
    backend.setProperty("observationHealth", observation_health)


def load_world_artwork(overrides):
    """Decode explicit local artwork once, within fixed input and texture limits."""
    from PyQt6.QtCore import QByteArray, QBuffer, QIODevice, QSize, Qt
    from PyQt6.QtGui import QImageReader

    categories = {"projects", "research", "social", "focus"}
    max_bytes = 8 * 1024 * 1024
    images = {}
    for override in overrides:
        category, separator, filename = override.partition("=")
        if not separator or category not in categories or not filename or category in images:
            raise ValueError("Expected one CATEGORY=PATH override per projects, research, social, or focus")
        try:
            fd = os.open(Path(filename).expanduser(), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as source:
                info = os.fstat(source.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_size > max_bytes:
                    raise ValueError(f"{category} artwork must be a regular file up to 8 MiB")
                data = source.read(max_bytes + 1)
        except OSError as exc:
            raise ValueError(f"{category} artwork could not be opened as a local file") from exc
        if len(data) > max_bytes:
            raise ValueError(f"{category} artwork exceeds 8 MiB")
        device = QBuffer()
        device.setData(QByteArray(data))
        device.open(QIODevice.OpenModeFlag.ReadOnly)
        reader = QImageReader(device)
        if bytes(reader.format()) not in (b"jpeg", b"png", b"webp"):
            raise ValueError(f"{category} artwork needs a PNG, JPEG, or WebP")
        size = reader.size()
        if (not size.isValid()
                or size.width() > 4096 or size.height() > 4096
                or size.width() * size.height() > 4_194_304):
            raise ValueError(f"{category} artwork exceeds the decode limit")
        texture_bound = QSize(640, 384)
        if size.width() > texture_bound.width() or size.height() > texture_bound.height():
            reader.setScaledSize(size.scaled(texture_bound, Qt.AspectRatioMode.KeepAspectRatio))
        image = reader.read()
        if image.isNull():
            raise ValueError(f"{category} artwork could not be decoded")
        images[category] = image
    return images


def main():
    parser = argparse.ArgumentParser(
        description="DepthOS Spatial Workspace Alpha Standalone Viewport"
    )
    parser.add_argument(
        "--mock", "--demo",
        action="store_true",
        help="Force standalone demo/mock mode even if DepthOS Controller D-Bus is available"
    )
    parser.add_argument(
        "--db",
        type=Path,
        help="Optional DepthOS SQLite database to read logical hierarchy from"
    )
    parser.add_argument(
        "--reduced-motion",
        action="store_true",
        help="Enable reduced motion mode (instant animations)"
    )
    parser.add_argument(
        "--offscreen",
        action="store_true",
        help="Run using offscreen QPA platform (for automated test validation)"
    )
    parser.add_argument(
        "--quit-after-ms",
        type=int,
        default=0,
        help="Automatically quit after specified milliseconds (for testing)"
    )
    parser.add_argument("--depthos-bin", type=Path, help="depthos binary used for status/init/tree (or DEPTHOS_BIN)")
    parser.add_argument("--frame-log", type=Path, help="JSONL frame timings (or DEPTHOS_FRAME_LOG). Own window only.")
    parser.add_argument("--memory-log", type=Path, help="JSONL RSS/PSS samples (or DEPTHOS_MEMORY_LOG)")
    parser.add_argument("--screenshot", type=Path, help="PNG of this window via grabWindow (or DEPTHOS_SCREENSHOT)")
    parser.add_argument("--world-art", metavar="CATEGORY=PATH", action="append", default=[],
                        help="Override a World artwork category with a bounded local PNG, JPEG, or WebP")
    parser.add_argument("--reference-demo", action="store_true",
                        help="Open the built-in reference catalog with Research selected")
    parser.add_argument("--window-size", metavar="WIDTHxHEIGHT",
                        help="Set the initial size of the DepthOS window in logical pixels")
    args = parser.parse_args()
    size = None
    if args.window_size:
        match = re.fullmatch(r"([1-9][0-9]{0,4})x([1-9][0-9]{0,4})", args.window_size)
        if not match:
            parser.error("--window-size expects two positive dimensions, for example 1672x941")
        size = tuple(map(int, match.groups()))
    if args.reference_demo and args.db is not None:
        parser.error("--reference-demo and --db select different data sources")
    global DEPTHOS
    if args.depthos_bin:
        DEPTHOS = args.depthos_bin
    elif os.environ.get("DEPTHOS_BIN"):
        DEPTHOS = Path(os.environ["DEPTHOS_BIN"])
    if args.frame_log is None and os.environ.get("DEPTHOS_FRAME_LOG"):
        args.frame_log = Path(os.environ["DEPTHOS_FRAME_LOG"])
    if args.memory_log is None and os.environ.get("DEPTHOS_MEMORY_LOG"):
        args.memory_log = Path(os.environ["DEPTHOS_MEMORY_LOG"])
    if args.screenshot is None and os.environ.get("DEPTHOS_SCREENSHOT"):
        args.screenshot = Path(os.environ["DEPTHOS_SCREENSHOT"])

    # Configure platform environment
    if args.offscreen:
        os.environ["QT_QPA_PLATFORM"] = "offscreen"
        os.environ["QT_QUICK_BACKEND"] = "software"
    elif "WAYLAND_DISPLAY" in os.environ:
        os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")

    # Import PyQt6
    try:
        from PyQt6.QtCore import QFileDevice, QIODevice, QSaveFile, QUrl, QTimer, QObject, Qt, pyqtSignal, pyqtSlot
        from PyQt6.QtGui import QGuiApplication
        from PyQt6.QtQml import QQmlApplicationEngine
        from PyQt6.QtQuick import QQuickWindow
        from PyQt6.QtDBus import QDBusConnection, QDBusServiceWatcher
    except ImportError as e:
        sys.stderr.write(f"depthos-spatial-alpha: PyQt6 is required but could not be imported: {e}\n")
        sys.exit(1)

    app = QGuiApplication(sys.argv)
    app.setApplicationName("DepthOS Spatial Workspace Alpha")
    app.setOrganizationName("DepthOS")
    app.setOrganizationDomain("org.depthos")

    # Allow clean Ctrl+C termination
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    sigint_timer = QTimer()
    sigint_timer.timeout.connect(lambda: None)
    sigint_timer.start(250)

    engine = QQmlApplicationEngine()
    if args.world_art:
        from PyQt6.QtCore import QSize
        from PyQt6.QtGui import QImage
        from PyQt6.QtQuick import QQuickImageProvider

        try:
            artwork = load_world_artwork(args.world_art)
        except ValueError as exc:
            parser.error(str(exc))

        class ArtworkProvider(QQuickImageProvider):
            def requestImage(self, name, _requested_size):
                image = artwork.get(name)
                return (image, image.size()) if image is not None else (QImage(), QSize())

        engine.addImageProvider("world-art", ArtworkProvider(QQuickImageProvider.ImageType.Image))


    qml_file = discover_qml_file()
    if not qml_file.exists():
        sys.stderr.write(f"depthos-spatial-alpha: QML file not found: {qml_file}\n")
        sys.exit(1)

    qml_dir = qml_file.parent
    engine.addImportPath(str(qml_dir))

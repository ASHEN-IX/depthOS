    def capture():
        try:
            if not isinstance(root, QQuickWindow):
                raise RuntimeError("the own-window surface is unavailable")
            args.screenshot.parent.mkdir(parents=True, exist_ok=True)
            image = root.grabWindow()
            output = QSaveFile(str(args.screenshot))
            if image.isNull() or not output.open(QIODevice.OpenModeFlag.WriteOnly):
                raise RuntimeError("could not capture the window or open the output file")
            try:
                permissions = QFileDevice.Permission.ReadOwner | QFileDevice.Permission.WriteOwner
                if not output.setPermissions(permissions) or not image.save(output, "PNG"):
                    raise RuntimeError("could not write a private PNG")
                if not output.commit():
                    raise RuntimeError("could not save the PNG")
            finally:
                if output.isOpen():
                    output.cancelWriting()
        except Exception as exc:
            sys.stderr.write(f"depthos-spatial-alpha: screenshot failed: {exc}\n")

    if args.screenshot:
        delay = 700
        if args.quit_after_ms > 0:
            delay = max(250, min(700, args.quit_after_ms - 400))
        QTimer.singleShot(delay, capture)
    if args.quit_after_ms > 0:
        def shutdown():
            if memory_probe:
                memory_probe.close()
            if frame_probe:
                frame_probe.close()
            app.quit()
        QTimer.singleShot(args.quit_after_ms, shutdown)

    source = backend.property("sourceKind")
    observer = backend.property("observerLabel")
    onboarding = backend.property("onboardingState")
    if args.mock or source == "demo":
        print("[depthos-spatial-alpha] Running in Standalone Demo/Mock Mode (Controller offline or --mock flag set).")
    elif source == "sqlite":
        print(f"[depthos-spatial-alpha] Loaded logical hierarchy directly from database: {backend.property('databasePath')}")
    elif source == "controller":
        print("[depthos-spatial-alpha] Connected to org.depthos.Controller on session bus.")
    print("[depthos-spatial-alpha] Spatial viewport loaded successfully. Press H/J/K/L, Enter, Esc, /.")
    sys.stderr.write(
        f"[depthos-spatial-alpha] source={source} observer={observer} onboarding={onboarding}\n"
    )
    sys.stderr.write("[depthos-spatial-alpha] Viewport ready. H/J/K/L, Enter, double-click, wheel, Esc, /.\n")
    code = app.exec()
    reader = getattr(engine, "controller_reader", None)
    if reader is not None:
        reader.pool.shutdown(wait=True, cancel_futures=True)
    if memory_probe and not memory_probe.file.closed:
        memory_probe.close()
    if frame_probe and not frame_probe.file.closed:
        frame_probe.close()
    sys.exit(code)


if __name__ == "__main__":
    main()

        @pyqtSlot()
        def createWorkspace(self):
            path = self.be.property("databasePath") or (str(self.db_path) if self.db_path else "")
            if not path:
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not create the workspace")
                self.be.setProperty("onboardingDetail", "No database path is selected. Nothing was written.")
                return
            proc = run_depthos(["--db", str(path), "init", "--default-hierarchy"])
            if proc is None or proc.returncode != 0:
                detail = "depthos binary was not found. Nothing was written."
                if proc is not None:
                    detail = (proc.stderr or proc.stdout or "init failed").strip()
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not create the workspace")
                self.be.setProperty("onboardingDetail", detail)
                return
            try:
                report = json.loads(proc.stdout)
            except json.JSONDecodeError:
                report = {}
            if not load_from_db_path(path, self.be):
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not read the workspace after initialization")
                self.be.setProperty("onboardingDetail", "The database was not modified again.")
                return
            outcome = str(report.get("outcome", ""))
            if outcome == "already-initialized":
                self.be.setProperty("onboardingMessage", "Workspace already exists")
                self.be.setProperty("onboardingDetail", "Nothing was overwritten.")
            else:
                self.be.setProperty("onboardingMessage", "Workspace created")
                self.be.setProperty("onboardingDetail", f"Initialization finished ({outcome})." if outcome else "Initialization finished.")
            self.be.setProperty("onboardingState", "success")
            if self.sc:
                self.sc.syncIndices()
            self.hierarchyChanged.emit()

        @pyqtSlot()
        def retryProbe(self):
            choose_source(self.be, self.sc, self.db_path, allow_controller=self.db_path is None)

        @pyqtSlot(str, result=str)
        def executeManagement(self, req_json):
            if not req_json or len(req_json.encode("utf-8")) > 1048576:
                return json.dumps({
                    "success": False,
                    "error": "Management request payload exceeds 1 MiB limit or is empty",
                    "code": "invalid_payload"
                })

            try:
                req_obj = json.loads(req_json)
                action = req_obj.get("action", "")
            except Exception as e:
                return json.dumps({
                    "success": False,
                    "error": f"Invalid JSON payload: {e}",
                    "code": "malformed_json"
                })

            allowed_actions = {
                "create", "update", "reorder", "archive", "restore",
                "delete", "inspectProject", "getPreferences", "setPreferences"
            }
            if action not in allowed_actions:
                return json.dumps({
                    "success": False,
                    "error": f"Disallowed action '{action}'. Permitted actions: {sorted(allowed_actions)}",
                    "code": "invalid_action"
                })

            if self.be.property("isDemo"):
                return self._execute_mock_management(req_json)

            path = self.be.property("databasePath") or (str(self.db_path) if self.db_path else "")
            if not path:
                return json.dumps({
                    "success": False,
                    "error": "No database path configured. Initialize a database first.",
                    "code": "no_database"
                })

            proc = run_depthos(["--db", str(path), "manage", "exec", "--request", req_json], timeout=10.0)
            if proc is None:
                return json.dumps({
                    "success": False,
                    "error": "depthos executable not found",
                    "code": "missing_binary"
                })

            if proc.returncode == 124:
                return json.dumps({
                    "success": False,
                    "error": proc.stderr.strip() or "Operation timed out",
                    "code": "timeout"
                })

            stdout = proc.stdout.strip()
            try:
                resp = json.loads(stdout)
            except Exception:
                return json.dumps({
                    "success": False,
                    "error": proc.stderr.strip() or stdout or "Unknown execution failure",
                    "code": "exec_failed"
                })

            if resp.get("success"):
                try:
                    if action in ("create", "update", "reorder", "archive", "restore", "delete"):
                        load_from_db_path(path, self.be)
                        if self.sc:
                            self.sc.syncIndices()
                        self.hierarchyChanged.emit()
                except Exception as exc:
                    sys.stderr.write(f"depthos-spatial-alpha: error reloading after management: {exc}\n")

            return stdout

        def _execute_mock_management(self, req_json):
            try:
                req = json.loads(req_json)
            except Exception as e:
                return json.dumps({"success": False, "error": str(e), "code": "invalid_json"})

            action = req.get("action", "")
            entity = req.get("entity", "")
            op_id = req.get("operationId")
            p = req.get("payload") or {}

            if action == "inspectProject":
                path = p.get("path") or req.get("id") or ""
                return self.inspectProject(path)

            if action == "getArchived":
                return json.dumps({"success": True, "data": []})

            if action == "getAssociationImpact":
                return json.dumps({"success": True, "data": {"ruleCount": 0}})

            if action == "create":
                new_id = f"mock-{int(time.time() * 1000)}"
                if entity == "world":
                    worlds = list(self.be.property("worlds") or [])
                    worlds.append({
                        "id": new_id,
                        "name": p.get("name", "New World"),
                        "description": p.get("description", ""),
                        "visualIdentity": p.get("visualIdentity", "neon-cyan"),
                        "artworkIdentifier": p.get("artwork", "cyber-grid"),
                        "version": 1,
                    })
                    self.be.setProperty("worlds", worlds)
                elif entity == "workspace":
                    workspaces = list(self.be.property("workspaces") or [])
                    workspaces.append({
                        "id": new_id,
                        "worldId": req.get("parentId", ""),
                        "name": p.get("name", "New Workspace"),
                        "description": p.get("description", ""),
                        "rootDirectory": p.get("rootDirectory", ""),
                        "visualIdentity": p.get("visualIdentity", "neon-cyan"),
                        "version": 1,
                    })
                    self.be.setProperty("workspaces", workspaces)
                elif entity == "desktop":
                    desktops = list(self.be.property("desktops") or [])
                    desktops.append({
                        "id": new_id,
                        "workspaceId": req.get("parentId", ""),
                        "name": p.get("name", "New Desktop"),
                        "role": p.get("role", "dev"),
                        "visualIdentity": p.get("visualIdentity", "neon-cyan"),
                        "version": 1,
                    })
                    self.be.setProperty("desktops", desktops)
                if self.sc:
                    self.sc.syncIndices()
                self.hierarchyChanged.emit()
                return json.dumps({"success": True, "operationId": op_id, "id": new_id, "version": 1})

            if action in ("update", "archive", "restore", "delete"):
                return json.dumps({"success": True, "operationId": op_id, "id": req.get("id"), "version": 2})

            return json.dumps({"success": True, "operationId": op_id})

        @pyqtSlot(str, result=str)
        def inspectProject(self, path):
            proc = run_depthos(["project", "inspect", path])
            if proc is None:

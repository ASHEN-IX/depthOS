#!/usr/bin/env python3
"""DepthOS Spatial Workspace Alpha - Standalone Development Application.

Runs an interactive QtQuick scene graph window on KDE Wayland. Source selection
is explicit: --mock loads demo data, --db reads that file, otherwise a connected
controller is used when one is on the session bus, otherwise the default database
is probed read-only. A missing database shows an offer. Demo data is never
substituted silently, and nothing is created until "Create my workspace".

Safe development launch commands:
    ./tools/depthos-spatial-alpha
    ./tools/depthos-spatial-alpha --mock
    ./tools/depthos-spatial-alpha --reduced-motion
    depthos ui
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import signal
import stat
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
QML_FILE = ROOT / "experiments/spatial-alpha/main.qml"
DEPTHOS = None
CONTROLLER_SERVICE = "org.depthos.Controller"
CONTROLLER_PATH = "/org/depthos/Controller"
CONTROLLER_INTERFACE = "org.depthos.Controller1"


def date_label(timestamp_ms=None):
    try:
        instant = (datetime.now(timezone.utc) if timestamp_ms is None
                   else datetime.fromtimestamp(timestamp_ms / 1000, timezone.utc))
    except (OverflowError, OSError, TypeError, ValueError):
        return ""
    return instant.isoformat(timespec="seconds")

# Init refuses these. The UI must not offer "Create" as if it would succeed.
BLOCKED_DB_STATES = {
    "corrupt",
    "unsupported-schema",
    "permission-denied",
    "unsafe-permissions",
    "symlink",
    "hardlink",
    "foreign",
}


def depthos_executable():
    """Locate the depthos binary without touching a database."""
    candidates = []
    if DEPTHOS:
        candidates.append(Path(DEPTHOS))
    env_bin = os.environ.get("DEPTHOS_BIN")
    if env_bin:
        candidates.append(Path(env_bin))
    cargo = os.environ.get("CARGO_TARGET_DIR")
    if cargo:
        candidates.append(Path(cargo) / "debug" / "depthos")
        candidates.append(Path(cargo) / "release" / "depthos")
    candidates.append(ROOT / "target" / "debug" / "depthos")
    candidates.append(ROOT / "target" / "release" / "depthos")
    for candidate in candidates:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    return None


def run_depthos(args):
    exe = depthos_executable()
    if exe is None:
        return None
    return subprocess.run([str(exe), *args], capture_output=True, text=True)


def status_json(db_path):
    """Read-only probe. Never creates or migrates the database."""
    cmd = ["status", "--json"]
    if db_path is not None:
        cmd = ["--db", str(db_path), *cmd]
    proc = run_depthos(cmd)
    if proc is None:
        return None, "depthos binary was not found. Nothing was created or modified."
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "status failed").strip()
        return None, detail
    try:
        return json.loads(proc.stdout), None
    except json.JSONDecodeError as exc:
        return None, f"depthos status returned invalid JSON: {exc}"


def clear_hierarchy(backend):
    for prop in ("worlds", "workspaces", "desktops", "windows"):
        backend.setProperty(prop, [])
    for prop in ("selectedWorldId", "selectedWorkspaceId", "selectedDesktopId", "selectedWindowId"):
        backend.setProperty(prop, "")
    backend.setProperty("mockMode", False)
    backend.setProperty("observerLive", False)
    backend.setProperty("observationHealth", "Unavailable")
    backend.setProperty("sourceKind", "none")
    backend.setProperty("sourceLoadedAt", "")
    backend.setProperty("state", "Unavailable")


def apply_sqlite_provenance(backend, db_path):
    backend.setProperty("mockMode", False)
    backend.setProperty("sourceKind", "sqlite")
    backend.setProperty("sourceLoadedAt", date_label())
    backend.setProperty("sourceDetail", str(db_path))
    backend.setProperty("state", "Database Mode")
    backend.setProperty("health", "Local")
    # A local file is not a native observer, even when the read succeeded.
    backend.setProperty("observerLive", False)
    backend.setProperty("observerDetail", "Local SQLite has no native observation channel")
    backend.setProperty("observationHealth", "Unavailable")
    backend.setProperty("databasePath", str(db_path))
    backend.setProperty("databaseState", "valid")


def load_from_db_path(db_path, backend):
    exe = depthos_executable()
    if exe is None:
        return False
    try:
        proc = subprocess.run(
            [str(exe), "--db", str(db_path), "tree"],
            capture_output=True, text=True, check=True,
        )
        data = json.loads(proc.stdout)
        worlds = []
        workspaces = []
        desktops = []
        for w in data.get("worlds", []):
            world_info = w.get("world", {})
            w_id = world_info.get("id")
            worlds.append({
                "id": w_id,
                "name": world_info.get("name", "World"),
                "description": world_info.get("description") or "",
            })
            for ws in w.get("workspaces", []):
                ws_info = ws.get("workspace", {})
                ws_id = ws_info.get("id")
                workspaces.append({
                    "id": ws_id,
                    "worldId": w_id,
                    "name": ws_info.get("name", "Workspace"),
                    "description": ws_info.get("description") or "",
                    "rootDirectory": ws_info.get("root_directory") or "",
                    "updatedAt": date_label(ws_info["updated_at_ms"]) if ws_info.get("updated_at_ms") else "",
                })
                for d in ws.get("desktops", []):
                    desktops.append({
                        "id": d.get("id"),
                        "workspaceId": ws_id,
                        "name": d.get("name", "Desktop"),
                        "role": d.get("role") or ""
                    })
        backend.setProperty("worlds", worlds)
        backend.setProperty("workspaces", workspaces)
        backend.setProperty("desktops", desktops)
        backend.setProperty("windows", [])
        apply_sqlite_provenance(backend, db_path)
        if worlds:
            backend.setProperty("selectedWorldId", worlds[0]["id"])
            sub_ws = [ws for ws in workspaces if ws["worldId"] == worlds[0]["id"]]
            if sub_ws:
                backend.setProperty("selectedWorkspaceId", sub_ws[0]["id"])
                sub_d = [d for d in desktops if d["workspaceId"] == sub_ws[0]["id"]]
                if sub_d:
                    backend.setProperty("selectedDesktopId", sub_d[0]["id"])
        return True
    except Exception:
        sys.stderr.write("depthos-spatial-alpha: Could not read the logical hierarchy from SQLite.\n")
        return False


def read_controller(owner):
    """Fetch the bounded read-only projection on a worker thread."""
    import dbus

    bus = dbus.SessionBus(private=True)
    try:
        endpoint = dbus.Interface(
            bus.get_object(owner, CONTROLLER_PATH, introspect=False), CONTROLLER_INTERFACE
        )
        deadline = time.monotonic() + 2

        def query(method, *args):
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Controller read timed out")
            reply = json.loads(str(method(*args, timeout=remaining)))
            if reply.get("schemaVersion") != 1:
                raise ValueError("Unsupported controller reply")
            return reply

        cursor = 0
        revision = ""
        worlds, workspaces, desktops = [], [], []
        # The bridge bounds hierarchy rows to 4096 and returns pages of 64.
        for _ in range(64):
            reply = query(endpoint.GetHierarchy, dbus.UInt32(cursor), revision)
            revision = reply["revision"]
            for item in reply["data"]["items"]:
                kind = item["kind"]
                row = {"id": item["id"], "name": item["name"]}
                if kind == "world":
                    worlds.append(row)
                elif kind == "workspace":
                    row["worldId"] = item["parentId"]
                    workspaces.append(row)
                elif kind == "desktop":
                    row["workspaceId"] = item["parentId"]
                    desktops.append(row)
            next_cursor = reply["data"]["nextCursor"]
            if next_cursor is None:
                break
            if not cursor < next_cursor < 4096:
                raise ValueError("Invalid hierarchy cursor")
            cursor = next_cursor
        else:
            raise ValueError("Hierarchy page limit exceeded")

        health_reply = query(endpoint.GetControllerHealth)
        health = health_reply["data"].get("health") or {}
        return worlds, workspaces, desktops, health, reply["available"]
    finally:
        bus.close()


def apply_controller_hierarchy(backend, hierarchy):
    worlds, workspaces, desktops = hierarchy
    # Controller context targets are Workspace IDs. The read-only projection
    # has no confirmed native-to-logical desktop mapping or display metadata.
    previous_desktop = backend.property("selectedDesktopId")
    previous_workspace = backend.property("selectedWorkspaceId")
    previous_world = backend.property("selectedWorldId")
    backend.setProperty("worlds", worlds)
    backend.setProperty("workspaces", workspaces)
    backend.setProperty("desktops", desktops)
    backend.setProperty("windows", [])
    world = next((w for w in worlds if w["id"] == previous_world), worlds[0] if worlds else None)
    descendants = [w for w in workspaces if world and w["worldId"] == world["id"]]
    workspace = next((w for w in descendants if w["id"] == previous_workspace),
                     descendants[0] if descendants else None)
    descendants = [d for d in desktops if workspace and d["workspaceId"] == workspace["id"]]
    desktop = next((d for d in descendants if d["id"] == previous_desktop),
                   descendants[0] if descendants else None)
    backend.setProperty("selectedWorldId", world["id"] if world else "")
    backend.setProperty("selectedWorkspaceId", workspace["id"] if workspace else "")
    backend.setProperty("selectedDesktopId", desktop["id"] if desktop else "")
    backend.setProperty("selectedWindowId", "")


def apply_controller_health(backend, health, hierarchy_available):
    lifecycle = health.get("lifecycle", "Unknown")
    observation = health.get("observation", "Unknown")
    observer_live = observation == "Synchronized"
    if observer_live:
        observation_health = "Live"
    elif observation == "Desynchronized":
        observation_health = "Stale"
    elif lifecycle in ("WaitingForObserver", "Recovering"):
        observation_health = "Reconnecting"
    else:
        observation_health = "Unavailable"

    backend.setProperty("onboardingState", "hidden")
    backend.setProperty("mockMode", False)
    backend.setProperty("sourceKind", "controller")
    detail = CONTROLLER_SERVICE if hierarchy_available else "Hierarchy unavailable"
    backend.setProperty("sourceDetail", detail)
    backend.setProperty("state", "Connected")
    backend.setProperty("health", lifecycle)
    backend.setProperty("observerLive", observer_live)
    backend.setProperty("observerDetail", observation)
    backend.setProperty("observationHealth", observation_health)


def load_world_artwork(overrides):
    """Decode explicit local artwork once, within fixed input and texture limits."""
    from PyQt6.QtCore import QByteArray, QBuffer, QIODevice, QSize, Qt
    from PyQt6.QtGui import QImageReader

    categories = {"projects", "research", "social", "focus"}
    max_bytes = 8 * 1024 * 1024
    images = {}
    for override in overrides:
        category, separator, filename = override.partition("=")
        if not separator or category not in categories or not filename or category in images:
            raise ValueError("Expected one CATEGORY=PATH override per projects, research, social, or focus")
        try:
            fd = os.open(Path(filename).expanduser(), os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, "rb") as source:
                info = os.fstat(source.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_size > max_bytes:
                    raise ValueError(f"{category} artwork must be a regular file up to 8 MiB")
                data = source.read(max_bytes + 1)
        except OSError as exc:
            raise ValueError(f"{category} artwork could not be opened as a local file") from exc
        if len(data) > max_bytes:
            raise ValueError(f"{category} artwork exceeds 8 MiB")
        device = QBuffer()
        device.setData(QByteArray(data))
        device.open(QIODevice.OpenModeFlag.ReadOnly)
        reader = QImageReader(device)
        if bytes(reader.format()) not in (b"jpeg", b"png", b"webp"):
            raise ValueError(f"{category} artwork needs a PNG, JPEG, or WebP")
        size = reader.size()
        if (not size.isValid()
                or size.width() > 4096 or size.height() > 4096
                or size.width() * size.height() > 4_194_304):
            raise ValueError(f"{category} artwork exceeds the decode limit")
        texture_bound = QSize(640, 384)
        if size.width() > texture_bound.width() or size.height() > texture_bound.height():
            reader.setScaledSize(size.scaled(texture_bound, Qt.AspectRatioMode.KeepAspectRatio))
        image = reader.read()
        if image.isNull():
            raise ValueError(f"{category} artwork could not be decoded")
        images[category] = image
    return images


def main():
    parser = argparse.ArgumentParser(
        description="DepthOS Spatial Workspace Alpha Standalone Viewport"
    )
    parser.add_argument(
        "--mock", "--demo",
        action="store_true",
        help="Force standalone demo/mock mode even if DepthOS Controller D-Bus is available"
    )
    parser.add_argument(
        "--db",
        type=Path,
        help="Optional DepthOS SQLite database to read logical hierarchy from"
    )
    parser.add_argument(
        "--reduced-motion",
        action="store_true",
        help="Enable reduced motion mode (instant animations)"
    )
    parser.add_argument(
        "--offscreen",
        action="store_true",
        help="Run using offscreen QPA platform (for automated test validation)"
    )
    parser.add_argument(
        "--quit-after-ms",
        type=int,
        default=0,
        help="Automatically quit after specified milliseconds (for testing)"
    )
    parser.add_argument("--depthos-bin", type=Path, help="depthos binary used for status/init/tree (or DEPTHOS_BIN)")
    parser.add_argument("--frame-log", type=Path, help="JSONL frame timings (or DEPTHOS_FRAME_LOG). Own window only.")
    parser.add_argument("--memory-log", type=Path, help="JSONL RSS/PSS samples (or DEPTHOS_MEMORY_LOG)")
    parser.add_argument("--screenshot", type=Path, help="PNG of this window via grabWindow (or DEPTHOS_SCREENSHOT)")
    parser.add_argument("--world-art", metavar="CATEGORY=PATH", action="append", default=[],
                        help="Override a World artwork category with a bounded local PNG, JPEG, or WebP")
    args = parser.parse_args()
    global DEPTHOS
    if args.depthos_bin:
        DEPTHOS = args.depthos_bin
    elif os.environ.get("DEPTHOS_BIN"):
        DEPTHOS = Path(os.environ["DEPTHOS_BIN"])
    if args.frame_log is None and os.environ.get("DEPTHOS_FRAME_LOG"):
        args.frame_log = Path(os.environ["DEPTHOS_FRAME_LOG"])
    if args.memory_log is None and os.environ.get("DEPTHOS_MEMORY_LOG"):
        args.memory_log = Path(os.environ["DEPTHOS_MEMORY_LOG"])
    if args.screenshot is None and os.environ.get("DEPTHOS_SCREENSHOT"):
        args.screenshot = Path(os.environ["DEPTHOS_SCREENSHOT"])

    # Configure platform environment
    if args.offscreen:
        os.environ["QT_QPA_PLATFORM"] = "offscreen"
        os.environ["QT_QUICK_BACKEND"] = "software"
    elif "WAYLAND_DISPLAY" in os.environ:
        os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")

    # Import PyQt6
    try:
        from PyQt6.QtCore import QFileDevice, QIODevice, QSaveFile, QUrl, QTimer, QObject, Qt, pyqtSignal, pyqtSlot
        from PyQt6.QtGui import QGuiApplication
        from PyQt6.QtQml import QQmlApplicationEngine
        from PyQt6.QtQuick import QQuickWindow
        from PyQt6.QtDBus import QDBusConnection, QDBusServiceWatcher
    except ImportError as e:
        sys.stderr.write(f"depthos-spatial-alpha: PyQt6 is required but could not be imported: {e}\n")
        sys.exit(1)

    app = QGuiApplication(sys.argv)
    app.setApplicationName("DepthOS Spatial Workspace Alpha")
    app.setOrganizationName("DepthOS")
    app.setOrganizationDomain("org.depthos")

    # Allow clean Ctrl+C termination
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    sigint_timer = QTimer()
    sigint_timer.timeout.connect(lambda: None)
    sigint_timer.start(250)

    engine = QQmlApplicationEngine()
    if args.world_art:
        from PyQt6.QtCore import QSize
        from PyQt6.QtGui import QImage
        from PyQt6.QtQuick import QQuickImageProvider

        try:
            artwork = load_world_artwork(args.world_art)
        except ValueError as exc:
            parser.error(str(exc))

        class ArtworkProvider(QQuickImageProvider):
            def requestImage(self, name, _requested_size):
                image = artwork.get(name)
                return (image, image.size()) if image is not None else (QImage(), QSize())

        engine.addImageProvider("world-art", ArtworkProvider(QQuickImageProvider.ImageType.Image))


    if not QML_FILE.exists():
        sys.stderr.write(f"depthos-spatial-alpha: QML file not found: {QML_FILE}\n")
        sys.exit(1)

    engine.load(QUrl.fromLocalFile(str(QML_FILE)))

    if not engine.rootObjects():
        sys.stderr.write("depthos-spatial-alpha: Failed to load QML root object\n")
        sys.exit(1)

    root = engine.rootObjects()[0]
    backend = root.property("backend")
    scene = root.property("scene")
    if args.world_art:
        backend.setProperty("customWorldArtwork", list(artwork))

    if scene.metaObject().indexOfProperty("pointerSelectionDelay") >= 0:
        scene.setProperty("pointerSelectionDelay", app.styleHints().mouseDoubleClickInterval() + 30)

    if args.reduced_motion:
        root.setProperty("reducedMotion", True)

    class HostBridge(QObject):
        def __init__(self, be, sc, db_path):
            super().__init__()
            self.be = be
            self.sc = sc
            self.db_path = db_path

        @pyqtSlot()
        def createWorkspace(self):
            path = self.be.property("databasePath") or (str(self.db_path) if self.db_path else "")
            if not path:
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not create the workspace")
                self.be.setProperty("onboardingDetail", "No database path is selected. Nothing was written.")
                return
            proc = run_depthos(["--db", str(path), "init", "--default-hierarchy"])
            if proc is None or proc.returncode != 0:
                detail = "depthos binary was not found. Nothing was written."
                if proc is not None:
                    detail = (proc.stderr or proc.stdout or "init failed").strip()
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not create the workspace")
                self.be.setProperty("onboardingDetail", detail)
                return
            try:
                report = json.loads(proc.stdout)
            except json.JSONDecodeError:
                report = {}
            if not load_from_db_path(path, self.be):
                self.be.setProperty("onboardingState", "error")
                self.be.setProperty("onboardingMessage", "Could not read the workspace after initialization")
                self.be.setProperty("onboardingDetail", "The database was not modified again.")
                return
            outcome = str(report.get("outcome", ""))
            if outcome == "already-initialized":
                self.be.setProperty("onboardingMessage", "Workspace already exists")
                self.be.setProperty("onboardingDetail", "Nothing was overwritten.")
            else:
                self.be.setProperty("onboardingMessage", "Workspace created")
                self.be.setProperty("onboardingDetail", f"Initialization finished ({outcome})." if outcome else "Initialization finished.")
            self.be.setProperty("onboardingState", "success")
            if self.sc:
                self.sc.syncIndices()

        @pyqtSlot()
        def retryProbe(self):
            choose_source(self.be, self.sc, self.db_path, allow_controller=self.db_path is None)

    def show_probe_failure(be, message, detail):
        clear_hierarchy(be)
        be.setProperty("onboardingState", "error")
        be.setProperty("onboardingMessage", message)
        be.setProperty("onboardingDetail", detail)
        be.setProperty("observerLive", False)
        be.setProperty("observationHealth", "Unavailable")

    def present_database(be, sc, db_path):
        status, err = status_json(db_path)
        if err or not status:
            show_probe_failure(be, "Could not inspect the workspace database", err or "status failed")
            return False
        path = status.get("path") or (str(db_path) if db_path else "")
        state = status.get("state") or "missing"
        be.setProperty("databasePath", path)
        be.setProperty("databaseState", state)
        detail = status.get("detail") or ""
        if state == "valid":
            if not load_from_db_path(path, be):
                show_probe_failure(be, "Could not read the workspace database", "tree failed. The file was not modified.")
                return False
            be.setProperty("onboardingState", "hidden")
            if sc:
                sc.syncIndices()
            return True
        clear_hierarchy(be)
        be.setProperty("databasePath", path)
        be.setProperty("databaseState", state)
        be.setProperty("onboardingDetail", detail)
        if state in ("missing", "empty"):
            be.setProperty("onboardingState", "offer")
            be.setProperty("onboardingMessage", "")
        elif state in BLOCKED_DB_STATES:
            be.setProperty("onboardingState", "blocked")
            be.setProperty("onboardingMessage", "This database cannot be opened")
        else:
            be.setProperty("onboardingState", "error")
            be.setProperty("onboardingMessage", "Could not open the workspace database")
        return False

    class ControllerReader(QObject):
        ready = pyqtSignal(str, object)

        def __init__(self, bus, owner):
            super().__init__(app)
            self.owner = owner
            self.busy = False
            self.pending = False
            self.hierarchy = None
            self.pool = ThreadPoolExecutor(max_workers=1, thread_name_prefix="depthos-controller")
            self.ready.connect(self.apply)
            self.watcher = QDBusServiceWatcher(
                CONTROLLER_SERVICE, bus,
                QDBusServiceWatcher.WatchModeFlag.WatchForOwnerChange, self,
            )
            self.watcher.serviceOwnerChanged.connect(self.owner_changed)
            bus.connect(
                CONTROLLER_SERVICE, CONTROLLER_PATH, CONTROLLER_INTERFACE,
                "Invalidated", "su", self.invalidated,
            )

        @pyqtSlot(str, "uint")
        def invalidated(self, _instance, _scope):
            self.refresh()

        def owner_changed(self, _service, _old, owner):
            self.owner = owner
            if backend.property("isDemo"):
                return
            self.mark_unavailable()
            self.refresh()

        def mark_unavailable(self):
            if backend.property("sourceKind") == "controller":
                backend.setProperty("sourceDetail", "Last controller snapshot")
            backend.setProperty("state", "Unavailable")
            backend.setProperty("health", "Unknown")
            backend.setProperty("observerLive", False)
            backend.setProperty("observerDetail", "Controller unavailable")
            backend.setProperty("observationHealth", "Unavailable")

        def refresh(self):
            if not self.owner or backend.property("isDemo"):
                return
            if self.busy:
                self.pending = True
                return
            self.busy = True
            owner = self.owner
            self.pool.submit(self.read, owner)

        def read(self, owner):
            try:
                payload = read_controller(owner)
            except Exception:
                # Transport errors can contain server-provided text.
                payload = None
            self.ready.emit(owner, payload)

        @pyqtSlot(str, object)
        def apply(self, owner, payload):
            self.busy = False
            if owner == self.owner and not backend.property("isDemo"):
                if payload is not None:
                    first = backend.property("sourceKind") != "controller"
                    was_connected = backend.property("state") == "Connected"
                    worlds, workspaces, desktops, health, available = payload
                    hierarchy = (worlds, workspaces, desktops)
                    if available and (first or hierarchy != self.hierarchy):
                        self.hierarchy = hierarchy
                        apply_controller_hierarchy(backend, hierarchy)
                        backend.setProperty("sourceLoadedAt", date_label())
                        scene.syncIndices()
                    apply_controller_health(backend, health, available)
                    if first:
                        finish_sync()
                    if not was_connected:
                        sys.stderr.write(
                            f"[depthos-spatial-alpha] controller ready; "
                            f"observer={backend.property('observationHealth')}\n"
                        )
                else:
                    self.mark_unavailable()
                    if backend.property("sourceKind") == "none":
                        present_database(backend, scene, None)
            if self.pending:
                self.pending = False
                self.refresh()

    def try_controller(be):
        reader = getattr(engine, "controller_reader", None)
        if reader is not None:
            if reader.owner:
                reader.refresh()
                return True
            return False
        bus = QDBusConnection.sessionBus()
        interface = bus.interface()
        if interface is None:
            return False
        reply = interface.serviceOwner(CONTROLLER_SERVICE)
        if not reply.isValid() or not reply.value():
            return False
        be.setProperty("state", "Connecting")
        reader = ControllerReader(bus, reply.value())
        engine.controller_reader = reader
        reader.refresh()
        return True

    def choose_source(be, sc, db_path, allow_controller):
        if args.mock:
            be.loadMock()
            be.setProperty("onboardingState", "hidden")
            if sc:
                sc.syncIndices()
            return
        if db_path is not None:
            # An explicit database is never replaced by the controller or by demo data.
            present_database(be, sc, db_path)
            return
        if allow_controller and try_controller(be):
            if sc:
                sc.syncIndices()
            return
        present_database(be, sc, None)

    bridge = HostBridge(backend, scene, args.db)
    root.setProperty("hostBridge", bridge)
    engine.bridge_ref = bridge
    choose_source(backend, scene, args.db, allow_controller=args.db is None)

    def finish_sync():
        state = backend.property("onboardingState")
        if scene and state in (None, "", "hidden"):
            scene.forceActiveFocus(Qt.FocusReason.OtherFocusReason)

    finish_sync()

    class FrameProbe(QObject):
        def __init__(self, window, path):
            super().__init__()
            path.parent.mkdir(parents=True, exist_ok=True)
            self.file = open(path, "w", buffering=1)
            os.chmod(path, 0o600)
            self.last = None
            self.before_t = None
            self.after_t = None
            self.count = 0
            window.beforeRendering.connect(self.on_before, Qt.ConnectionType.DirectConnection)
            window.afterRendering.connect(self.on_after, Qt.ConnectionType.DirectConnection)
            window.frameSwapped.connect(self.on_swap)
            info = {"kind": "renderer", "synthetic": False}
            try:
                quick = window if isinstance(window, QQuickWindow) else None
                if quick is None:
                    from PyQt6 import sip
                    quick = sip.cast(window, QQuickWindow)
                ri = quick.rendererInterface()
                api = ri.graphicsApi() if ri is not None else None
                info["graphicsApi"] = getattr(api, "value", None)
                info["graphicsApiName"] = str(api) if api is not None else None
            except Exception as exc:
                info["graphicsApiError"] = str(exc)
            info["platform"] = os.environ.get("QT_QPA_PLATFORM", "")
            self.file.write(json.dumps(info) + "\n")

        def on_before(self):
            self.before_t = time.perf_counter()

        def on_after(self):
            self.after_t = time.perf_counter()

        def on_swap(self):
            now = time.perf_counter()
            interval = None if self.last is None else round((now - self.last) * 1000.0, 4)
            render = None
            if self.before_t is not None and self.after_t is not None and self.after_t >= self.before_t:
                render = round((self.after_t - self.before_t) * 1000.0, 4)
            self.last = now
            self.count += 1
            self.file.write(json.dumps({
                "kind": "frame", "n": self.count, "intervalMs": interval, "renderMs": render,
            }) + "\n")

        def close(self):
            self.file.write(json.dumps({"kind": "summary", "frames": self.count}) + "\n")
            self.file.close()

    class MemoryProbe:
        def __init__(self, path):
            path.parent.mkdir(parents=True, exist_ok=True)
            self.file = open(path, "w", buffering=1)
            os.chmod(path, 0o600)
            self.timer = QTimer()
            self.timer.timeout.connect(lambda: self.sample("tick"))
            self.timer.start(1000)
            self.sample("start")

        def sample(self, reason):
            data = {"t": round(time.time(), 3), "reason": reason, "pid": os.getpid()}
            try:
                for line in Path("/proc/self/status").read_text().splitlines():
                    key, _, value = line.partition(":")
                    if key in ("VmRSS", "VmHWM", "VmSize", "VmSwap", "RssAnon", "RssFile", "RssShmem"):
                        data[key] = value.strip()
            except OSError as exc:
                data["statusError"] = str(exc)
            rollup = Path("/proc/self/smaps_rollup")
            if rollup.exists():
                try:
                    for line in rollup.read_text().splitlines():
                        key, _, value = line.partition(":")
                        if key in ("Rss", "Pss", "Private_Dirty", "Private_Clean", "Anonymous", "Shared_Clean", "Shared_Dirty"):
                            data[key] = value.strip()
                except OSError as exc:
                    data["rollupError"] = str(exc)
            drm = []
            fdinfo = Path("/proc/self/fdinfo")
            if fdinfo.is_dir():
                for entry in sorted(fdinfo.iterdir()):
                    try:
                        text = entry.read_text(errors="replace")
                    except OSError:
                        continue
                    if "drm-" in text:
                        drm.append(text.strip())
                    if len(drm) >= 4:
                        break
            if drm:
                data["drmFdinfo"] = drm
            self.file.write(json.dumps(data) + "\n")

        def close(self):
            self.timer.stop()
            self.sample("exit")
            self.file.close()

    frame_probe = FrameProbe(root, args.frame_log) if args.frame_log else None
    memory_probe = MemoryProbe(args.memory_log) if args.memory_log else None
    if frame_probe:
        engine.frame_probe = frame_probe
    if memory_probe:
        engine.memory_probe = memory_probe

    def capture():
        try:
            if not isinstance(root, QQuickWindow):
                raise RuntimeError("the own-window surface is unavailable")
            args.screenshot.parent.mkdir(parents=True, exist_ok=True)
            image = root.grabWindow()
            output = QSaveFile(str(args.screenshot))
            if image.isNull() or not output.open(QIODevice.OpenModeFlag.WriteOnly):
                raise RuntimeError("could not capture the window or open the output file")
            try:
                permissions = QFileDevice.Permission.ReadOwner | QFileDevice.Permission.WriteOwner
                if not output.setPermissions(permissions) or not image.save(output, "PNG"):
                    raise RuntimeError("could not write a private PNG")
                if not output.commit():
                    raise RuntimeError("could not save the PNG")
            finally:
                if output.isOpen():
                    output.cancelWriting()
        except Exception as exc:
            sys.stderr.write(f"depthos-spatial-alpha: screenshot failed: {exc}\n")

    if args.screenshot:
        delay = 700
        if args.quit_after_ms > 0:
            delay = max(250, min(700, args.quit_after_ms - 400))
        QTimer.singleShot(delay, capture)
    if args.quit_after_ms > 0:
        def shutdown():
            if memory_probe:
                memory_probe.close()
            if frame_probe:
                frame_probe.close()
            app.quit()
        QTimer.singleShot(args.quit_after_ms, shutdown)

    source = backend.property("sourceKind")
    observer = backend.property("observerLabel")
    onboarding = backend.property("onboardingState")
    if args.mock or source == "demo":
        print("[depthos-spatial-alpha] Running in Standalone Demo/Mock Mode (Controller offline or --mock flag set).")
    elif source == "sqlite":
        print(f"[depthos-spatial-alpha] Loaded logical hierarchy directly from database: {backend.property('databasePath')}")
    elif source == "controller":
        print("[depthos-spatial-alpha] Connected to org.depthos.Controller on session bus.")
    print("[depthos-spatial-alpha] Spatial viewport loaded successfully. Press H/J/K/L, Enter, Esc, /.")
    sys.stderr.write(
        f"[depthos-spatial-alpha] source={source} observer={observer} onboarding={onboarding}\n"
    )
    sys.stderr.write("[depthos-spatial-alpha] Viewport ready. H/J/K/L, Enter, double-click, wheel, Esc, /.\n")
    code = app.exec()
    reader = getattr(engine, "controller_reader", None)
    if reader is not None:
        reader.pool.shutdown(wait=True, cancel_futures=True)
    if memory_probe and not memory_probe.file.closed:
        memory_probe.close()
    if frame_probe and not frame_probe.file.closed:
        frame_probe.close()
    sys.exit(code)


if __name__ == "__main__":
    main()

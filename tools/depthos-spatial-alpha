    class HostBridge(QObject):
        managementCompleted = pyqtSignal(str, bool, str)
        hierarchyChanged = pyqtSignal()

        def __init__(self, be, sc, db_path, root_win):
            super().__init__()
            self.be = be
            self.sc = sc
            self.db_path = db_path
            self.root_win = root_win

        def _db_args(self):
            path = self.be.property("databasePath") or (str(self.db_path) if self.db_path else "")

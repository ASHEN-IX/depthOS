import json
import os
from pathlib import Path
import re
import shutil
import signal
import stat
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
DEPTHOS = None
CONTROLLER_SERVICE = "org.depthos.Controller"
CONTROLLER_PATH = "/org/depthos/Controller"
CONTROLLER_INTERFACE = "org.depthos.Controller1"


def discover_qml_file():
    """Locate the main.qml file for DepthOS Spatial Alpha.
    Order:
      1. DEPTHOS_QML_FILE or DEPTHOS_QML_DIR / main.qml
      2. Sibling prefix: <prefix>/share/depthos/spatial-alpha/main.qml
      3. XDG_DATA_HOME / depthos/spatial-alpha/main.qml
      4. XDG_DATA_DIRS entries / depthos/spatial-alpha/main.qml
      5. Development fallback: ROOT / experiments/spatial-alpha/main.qml
    """
    candidates = []

    if os.environ.get("DEPTHOS_QML_FILE"):
        candidates.append(Path(os.environ["DEPTHOS_QML_FILE"]))
    if os.environ.get("DEPTHOS_QML_DIR"):
        candidates.append(Path(os.environ["DEPTHOS_QML_DIR"]) / "main.qml")

    script_dir = Path(__file__).resolve().parent
    prefix = script_dir.parent
    candidates.append(prefix / "share" / "depthos" / "spatial-alpha" / "main.qml")

    xdg_data_home = os.environ.get("XDG_DATA_HOME")
    if xdg_data_home:
        candidates.append(Path(xdg_data_home) / "depthos" / "spatial-alpha" / "main.qml")
    else:
        candidates.append(Path.home() / ".local" / "share" / "depthos" / "spatial-alpha" / "main.qml")

    xdg_data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for d in xdg_data_dirs.split(":"):
        d_str = d.strip()
        if d_str:
            candidates.append(Path(d_str) / "depthos" / "spatial-alpha" / "main.qml")

    candidates.append(ROOT / "experiments" / "spatial-alpha" / "main.qml")

    for candidate in candidates:
        if candidate.is_file():
            return candidate.resolve()
    return candidates[-1]


QML_FILE = discover_qml_file()


def date_label(timestamp_ms=None):
    try:
        instant = (datetime.now(timezone.utc) if timestamp_ms is None
                   else datetime.fromtimestamp(timestamp_ms / 1000, timezone.utc))
    except (OverflowError, OSError, TypeError, ValueError):
        return ""
    return instant.isoformat(timespec="seconds")

